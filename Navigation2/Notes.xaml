<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Navigation2.Notes"
             Title="Notes">
    <VerticalStackLayout>
        <Label 
            Text="{Binding title}"
            x:Name="NotesNameLabel"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Label 
            Text="{Binding desc}"
            VerticalOptions="Center"
            x:Name="NotesDescLabel"
            HorizontalOptions="Center" />
        <Button Clicked="OnGoBack" Text="Wróć"></Button>
    </VerticalStackLayout>
</ContentPage>